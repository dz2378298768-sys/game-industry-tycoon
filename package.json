{
  "name": "game-industry-tycoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run --config vite.config.ts",
    "test:ui": "vitest run --config vite.config.ts --ui",
    "desktop": "electron .",
    "package:pc": "npm run build && electron-builder --win --x64 --dir && node desktop/package-zip.mjs"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.82.0",
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sirv": "^3.0.2",
    "three": "^0.187.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.187.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^2.1.5",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.5"
  },
  "main": "desktop/main.mjs",
  "productName": "Game Industry Tycoon"
}
